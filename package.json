{
  "name": "bookmark-shelf",
  "version": "0.2.0",
  "description": "Chrome extension for bookmarks and a local media library",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node scripts/check-project.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/verify.mjs",
    "check:vendor": "node scripts/check-vendor.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:technical": "node scripts/release-check.mjs --technical",
    "check:publication": "node scripts/check-publication.mjs",
    "store:screenshots": "node scripts/store-assets.mjs"
  }
}
